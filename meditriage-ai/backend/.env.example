# Application Configuration
PROJECT_NAME="MediTriage AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & Authentication
# Generate strong secret key: python -c "import secrets; print(secrets.token_urlsafe(64))"
# In production, SECRET_KEY must be >= 32 characters and cannot be a default value.
SECRET_KEY=
# Separate key for cryptographic HMAC of audit logs (required outside development)
AUDIT_HMAC_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL mandatory for production)
DATABASE_URL="sqlite:///./meditriage.db"

# CORS Configuration (comma-separated origins including dev landing :3000 and frontend :3001)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# External AI Configuration (Keep private, never commit)
GEMINI_API_KEY=

# Skin & wound photo triage (Triage Flow module)
# Path to a Keras DermNet ResNet152 model (.h5/.keras). Leave empty to run without image analysis:
# photos are still stored for clinician review and triage uses symptoms only (graceful degradation).
SKIN_MODEL_PATH=
SKIN_MAX_UPLOAD_BYTES=5000000
SKIN_MAX_ANALYSES_PER_CASE=5
